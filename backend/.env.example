# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# In production, set to your Vercel/Render URL(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase Postgres connection string) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voyagerai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=3600

# --- ChromaDB Vector Store ---
# Use absolute path for Docker, relative for local dev
CHROMA_PERSIST_DIR=./chroma_data

# --- Auth (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- AI / Agents ---
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# --- Observability (optional) ---
# Get from https://sentry.io — free tier available
SENTRY_DSN=
